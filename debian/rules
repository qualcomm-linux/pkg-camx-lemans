#!/usr/bin/make -f

%:
	dh $@

override_dh_shlibdeps:
	dh_shlibdeps \
		-l/usr/lib/aarch64-linux-gnu/camx/lemans \
		-l/usr/lib/aarch64-linux-gnu/camx/lemans/hw

maintainerclean:
	rm -r \
		LICENSE.qcom-2 \
		camx-entitled-headers-dev/ \
		camx-lemans-dbgsym/ \
		camx-lemans-dev/ \
		camx-lemans/ \
		libcamx-dev/ \
		libcamx-lemans-dev/ \
		libcamx-lemans1-dbgsym/ \
		libcamx-lemans1/

override_dh_strip:
	# Don't strip DSP skel files
	dh_strip --exclude=libhme_dsp_skel.so --exclude=libbitml_nsp_73nb_skel.so

override_dh_dwz:
